NEVA_API_KEY=replace-with-your-nevatoken-key
NEVA_API_BASE_URL=https://nevatoken.com/v1
NEVA_MODEL=MaaS_GP_6_luna_20260922

# 登录验证码邮件（SMTP）。云服务器多封 25 端口，用 465（SSL）
# QQ 邮箱：smtp.qq.com，密码填「授权码」；163：smtp.163.com；阿里云邮件推送：smtpdm.aliyun.com
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=replace-with-sender@qq.com
SMTP_PASS=replace-with-smtp-auth-code
# 可选：发件人显示，默认「司命 <SMTP_USER>」
# MAIL_FROM=司命 <noreply@siming.art>

# 用户与记录数据库，默认 data/siming.db；生产环境由部署脚本指向 shared/data
# SIMING_DB_PATH=data/siming.db

# 仅本地开发：不真实发信，验证码打印在服务端日志里。生产环境开启会报错。
# MAIL_MOCK=1
