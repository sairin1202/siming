NEVA_API_KEY=replace-with-your-nevatoken-key
NEVA_API_BASE_URL=https://nevatoken.com/v1
NEVA_MODEL=MaaS_GP_6_luna_20260922

# 阿里云号码认证服务 · 短信认证（登录验证码）
# 建议用只授权 AliyunDypnsFullAccess 的 RAM 子账号 AccessKey
ALIYUN_ACCESS_KEY_ID=replace-with-ram-access-key-id
ALIYUN_ACCESS_KEY_SECRET=replace-with-ram-access-key-secret
# 控制台「赠送签名配置」「赠送模板配置」中的签名名称与模板 CODE
ALIYUN_SMS_SIGN_NAME=replace-with-sign-name
ALIYUN_SMS_TEMPLATE_CODE=100001
# 可选：方案名称
# ALIYUN_SMS_SCHEME_NAME=

# 用户与记录数据库，默认 data/siming.db；生产环境由部署脚本指向 shared/data
# SIMING_DB_PATH=data/siming.db

# 仅本地开发：不发真实短信，验证码固定为 000000。生产环境开启会报错。
# SMS_MOCK=1
